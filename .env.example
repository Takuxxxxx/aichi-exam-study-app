# ============ AI API 設定 ============
# どれか1つの API キーを設定してください（AI_API_KEY が優先、無ければ DEEPSEEK_API_KEY）

# ① Google Gemini 無料枠（おすすめ）: https://aistudio.google.com/apikey で取得
# AI_API_KEY=ここにGeminiのAPIキー
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.5-flash-lite

# ② DeepSeek: https://platform.deepseek.com/ で取得
# DEEPSEEK_API_KEY=
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# ③ Groq（無料・高速）: https://console.groq.com/keys で取得
# AI_API_KEY=ここにGroqのAPIキー
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile

# ============ サーバー設定 ============
PORT=3000

# ============ DB同期設定（PC⇔クラウド・任意） ============
# 自動同期するのは SYNC_PEER_URL を設定した側だけ（片方向開始）。
# 例: PC側の .env に SYNC_PEER_URL=https://xxx.duckdns.org と設定し、
# 両方の .env に同じ SYNC_SECRET を設定する。クラウド側は SYNC_PEER_URL 空欄のまま。
# SYNC_PEER_URL=
# SYNC_SECRET=
